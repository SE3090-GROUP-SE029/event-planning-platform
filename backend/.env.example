# Reference for .NET environment variable names. ASP.NET Core does not load this file automatically.
# Supply these through your development process environment or an ignored configuration file.
# Database configuration (provide the connection string locally).
ConnectionStrings__DefaultConnection=

# Reserved for the team's authentication and administrator-seeding implementation.
# Supplying these values alone does not enable login, token validation, or admin creation.
Jwt__Secret=
Jwt__Issuer=event_planning_platform
Jwt__Audience=reactDashboard_and_mobileApp
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
AdminSeed__Email=
AdminSeed__FirstName=System
AdminSeed__LastName=Administrator
AdminSeed__Password=

# Leave Host/FromAddress unset to retain invitation delivery as PENDING.
Smtp__Host=
Smtp__Port=587
Smtp__FromAddress=
Smtp__UserName=
Smtp__Password=
Smtp__EnableSsl=true
Smtp__TimeoutSeconds=10
# Local guest AI service. Set these as process environment variables for ASP.NET.
GuestAi__Enabled=true
GuestAi__ServiceUrl=http://127.0.0.1:8000/
GuestAi__TimeoutSeconds=120
GuestAi__PollSeconds=5
